{
  // Configuration Cloudflare Workers
  "name": "calendrier-noel",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "none"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "calendrier-noel-db" }
  ],
  "observability": { "enabled": true }
}
